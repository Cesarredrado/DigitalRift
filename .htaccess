<IfModule mod_rewrite.c>
  RewriteEngine On

  # 1) Redirecciones a URLs limpias (evita que aparezca *.html)
  RewriteCond %{THE_REQUEST} \s/+index\.html[\s?] [NC]
  RewriteRule ^index\.html$ / [R=301,L]

  RewriteCond %{THE_REQUEST} \s/+(.+?)\.html[\s?] [NC]
  RewriteRule ^(.+?)\.html$ /$1 [R=301,L]

  # 1.5) Canonicaliza: sin barra final (si no es un directorio real)
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^(.+)/$ /$1 [R=301,L]

  # 2) No tocar archivos o carpetas reales
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # 3) Reescritura interna: /quienes -> quienes.html (si existe)
  RewriteCond %{REQUEST_FILENAME}\.html -f
  RewriteRule ^(.+?)/?$ $1.html [L]
</IfModule>

# Asegura que / sirva index.html
DirectoryIndex index.html